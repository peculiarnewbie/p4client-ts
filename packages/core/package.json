{
  "name": "p4client-ts",
  "version": "0.13.0",
  "description": "Typed TypeScript helpers for the Perforce p4 CLI",
  "license": "MIT",
  "author": "peculiarnewbie",
  "keywords": [
    "perforce",
    "p4",
    "cli",
    "typescript",
    "version-control",
    "scm"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/peculiarnewbie/p4client-ts.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/peculiarnewbie/p4client-ts/issues"
  },
  "homepage": "https://p4client-ts.peculiarnewbie.com",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./promise": {
      "types": "./dist/promise/index.d.ts",
      "import": "./dist/promise/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "MIGRATION.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.type-tests.json && tsc -p tsconfig.scripts.json",
    "wire:capture": "bun scripts/capture-wire.ts",
    "test": "bun test tests/*.test.ts tests/unit/",
    "test:e2e": "bun scripts/test-perforce-e2e.ts",
    "docs:api": "typedoc --options typedoc.json",
    "docs:api:check": "typedoc --options typedoc.json",
    "pack:check": "bun scripts/pack-check.ts",
    "prepublishOnly": "bun run clean && bun run typecheck && bun run test && bun run build",
    "wire:reasons": "bun scripts/wire-reasons.ts"
  },
  "peerDependencies": {
    "effect": "^4.0.0-beta.37"
  },
  "devDependencies": {
    "effect": "4.0.0-beta.37"
  },
  "engines": {
    "node": ">=18"
  }
}
