{
  "name": "p4client-ts",
  "version": "0.14.0",
  "description": "Typed TypeScript helpers for the Perforce p4 CLI",
  "license": "MIT",
  "author": "peculiarnewbie",
  "keywords": [
    "perforce",
    "p4",
    "cli",
    "typescript",
    "version-control",
    "scm"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/peculiarnewbie/p4client-ts.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/peculiarnewbie/p4client-ts/issues"
  },
  "homepage": "https://p4client-ts.peculiarnewbie.com",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./promise": {
      "types": "./dist/promise/index.d.ts",
      "import": "./dist/promise/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "MIGRATION.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/types && tsc -p tests && tsc -p scripts",
    "wire:capture": "vpx scripts/capture-wire.ts",
    "test": "vp test run --config ../../vite.config.ts --project core",
    "test:e2e": "vpx scripts/test-perforce-e2e.ts",
    "pack:check": "vpx scripts/pack-check.ts",
    "prepublishOnly": "pnpm run clean && pnpm run typecheck && pnpm run test && pnpm run build",
    "wire:reasons": "vpx scripts/wire-reasons.ts"
  },
  "peerDependencies": {
    "effect": "^4.0.0"
  },
  "devDependencies": {
    "effect": "4.0.4"
  },
  "engines": {
    "node": ">=18"
  }
}
