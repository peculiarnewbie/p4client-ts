{
  "name": "p4-ts-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "effect-language-service patch",
    "build": "bun run --cwd packages/core build",
    "typecheck": "bun run --cwd packages/core typecheck",
    "lint": "effect-tsgo oxlint .",
    "lint:fix": "effect-tsgo oxlint --fix .",
    "tsrs": "effect-tsgo tsrs",
    "test": "bun run --cwd packages/core test && bun test ./tools/oxlint/t3code",
    "test:e2e": "bun run --cwd packages/core test:e2e",
    "wire:capture": "bun run --cwd packages/core wire:capture",
    "docs:dev": "bun run --cwd packages/www dev",
    "docs:build": "bun run --cwd packages/www build",
    "docs:check": "bun run --cwd packages/core docs:api:check && bun run --cwd packages/www check && bun run --cwd packages/www build",
    "clean": "bun run --cwd packages/core clean",
    "pack:core": "bun run --cwd packages/core pack:check",
    "effect:solutions": "bun scripts/effect-solutions.ts",
    "publish": "cd packages/core && npm publish"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/starlight": "^0.38.5",
    "@effect/language-service": "^0.87.5",
    "@effect/tsgo": "0.64.1",
    "@oxlint/plugins": "1.90.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^24.19.2",
    "astro": "^6.4.8",
    "effect": "4.0.4",
    "effect-solutions": "0.5.3",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "starlight-typedoc": "^0.21.5",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "^6.0.3"
  }
}
