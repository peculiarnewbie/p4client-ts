{
  "name": "p4-ts-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "prepare": "effect-language-service patch",
    "build": "vp run --filter p4client-ts build",
    "typecheck": "vp run --filter p4client-ts typecheck",
    "lint": "effect-tsgo oxlint .",
    "lint:fix": "effect-tsgo oxlint --fix .",
    "tsrs": "effect-tsgo tsrs",
    "test": "vp test run",
    "test:e2e": "vp run --filter p4client-ts test:e2e",
    "wire:capture": "vp run --filter p4client-ts wire:capture",
    "docs:dev": "vp run --filter @p4-ts/www dev",
    "docs:build": "vp run --filter @p4-ts/www build",
    "docs:check": "vp run --filter @p4-ts/www check && vp run --filter @p4-ts/www build",
    "clean": "vp run --filter p4client-ts clean",
    "pack:core": "vp run --filter p4client-ts pack:check",
    "effect:solutions": "vpx scripts/effect-solutions.ts",
    "publish": "cd packages/core && npm publish"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/starlight": "^0.38.5",
    "@effect/language-service": "^0.87.5",
    "@effect/tsgo": "0.67.3",
    "@types/node": "^24.19.2",
    "astro": "^6.4.8",
    "effect": "4.1.2",
    "effect-solutions": "0.5.3",
    "tsrs": "0.21.0-ts7.1.0-beta",
    "typescript": "^6.0.3",
    "vite-plus": "1.4.0"
  }
}
